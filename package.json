{
  "name": "vaultwright",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first maintenance layer for Obsidian vaults through a deterministic MCP server.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "corepack pnpm -r build",
    "test": "corepack pnpm -r test",
    "dev": "corepack pnpm --filter @vaultwright/mcp-server dev",
    "lint": "corepack pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,md,json,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "packageManager": "pnpm@9.0.0"
}
